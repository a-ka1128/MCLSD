// Last Stardust — Layer C: 공동 금고 (팀 공유 계좌)
// 잔액은 오버월드 persistentData에 저장(월드와 함께 영구 저장).
// 채워지는 곳: PvE 수입의 10% 기여(ls_income.js) + 플레이어 예치.
// 쓰는 곳: 마을 발전/자동화/방어 (op가 /treasury spend).

function store(server) { return server.overworld().persistentData }
function getT(server) { return store(server).getInt('ls_treasury') }
function setT(server, v) { store(server).putInt('ls_treasury', v < 0 ? 0 : v) }

// ls_income.js에서 호출
global.lsTreasuryAdd = (server, amount) => { setT(server, getT(server) + amount) }

ServerEvents.commandRegistry(event => {
  const { commands: Commands, arguments: Arguments } = event
  event.register(
    Commands.literal('treasury')
      // /treasury  또는 /treasury balance : 잔액 조회
      .executes(ctx => {
        ctx.source.sendSystemMessage(Text.of(`§6🏛️ 공동 금고: §e${getT(ctx.source.server)} Ducat`))
        return 1
      })
      .then(Commands.literal('balance').executes(ctx => {
        ctx.source.sendSystemMessage(Text.of(`§6🏛️ 공동 금고: §e${getT(ctx.source.server)} Ducat`))
        return 1
      }))
      // /treasury deposit <amount> : 개인 잔액 → 금고
      .then(Commands.literal('deposit')
        .then(Commands.argument('amount', Arguments.INTEGER.create(event)).executes(ctx => {
          const amt = Arguments.INTEGER.getResult(ctx, 'amount')
          const player = ctx.source.player
          if (!player || amt <= 0) return 0
          player.server.runCommandSilent(`eco remove ${player.username} ${amt}`)
          global.lsTreasuryAdd(player.server, amt)
          ctx.source.sendSystemMessage(Text.of(`§a+${amt} → 공동 금고 (총 ${getT(player.server)})`))
          return 1
        })))
      // /treasury spend <amount> : op가 마을 발전에 지출
      .then(Commands.literal('spend').requires(s => s.hasPermission(2))
        .then(Commands.argument('amount', Arguments.INTEGER.create(event)).executes(ctx => {
          const amt = Arguments.INTEGER.getResult(ctx, 'amount')
          const cur = getT(ctx.source.server)
          if (amt <= 0 || cur < amt) { ctx.source.sendSystemMessage(Text.of('§c금고 잔액 부족')); return 0 }
          setT(ctx.source.server, cur - amt)
          ctx.source.sendSystemMessage(Text.of(`§e공동 금고에서 ${amt} 사용 (남은: ${cur - amt})`))
          return 1
        })))
  )
})
